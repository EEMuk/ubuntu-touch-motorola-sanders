#!/bin/sh
# The flashlight toggle only drives torch-light0; sanders' dual-tone rear
# flash has a second (yellow) LED on torch-light1. Make it follow.
A=/sys/class/leds/torch-light0/brightness
B=/sys/class/leds/torch-light1/brightness
last=
while :; do
    v=$(cat $A)
    if [ "$v" != "$last" ]; then
        echo $v > $B
        last=$v
    fi
    sleep 0.3
done
