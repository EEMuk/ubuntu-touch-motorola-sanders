#!/usr/bin/python3
# Minimal stand-in for netd's /dev/socket/dnsproxyd.
#
# Android's bionic sends every getaddrinfo()/gethostbyname() to netd over
# this socket. Under Halium netd doesn't run, so vendor daemons in the
# container (Qualcomm xtra-daemon: assisted-GPS data and NTP time) can't
# resolve anything and GPS takes many minutes to get a first fix. Answer
# those requests with Ubuntu's resolver. /dev/socket is bind-mounted into
# the container, so the socket shows up there as well.
import os
import socket
import struct
import threading

PATH = "/dev/socket/dnsproxyd"
OK = b"222\0"            # DnsProxyQueryResult
ERR = b"401\0"           # DnsProxyOperationFailed


def be32(v):
    return struct.pack(">i", v)


def arg(s):
    return None if s == "^" else s


def getaddrinfo(conn, a):
    host, serv = arg(a[0]), arg(a[1])
    flags, family, socktype, proto = (int(x) for x in a[2:6])
    try:
        res = socket.getaddrinfo(host, serv,
                                 family if family >= 0 else 0,
                                 socktype if socktype >= 0 else 0,
                                 proto if proto >= 0 else 0,
                                 flags if flags >= 0 else 0)
    except socket.gaierror as e:
        conn.sendall(ERR + be32(-e.errno if e.errno and e.errno < 0 else 8))
        return
    out = [OK]
    for fam, st, pr, canon, sa in res:
        if fam == socket.AF_INET:
            raw = struct.pack("<H", fam) + struct.pack(">H", sa[1]) + \
                socket.inet_pton(fam, sa[0]) + b"\0" * 8
        elif fam == socket.AF_INET6:
            raw = struct.pack("<H", fam) + struct.pack(">H", sa[1]) + \
                struct.pack(">I", sa[2]) + socket.inet_pton(fam, sa[0]) + \
                struct.pack("<I", sa[3])
        else:
            continue
        out += [be32(1), be32(flags if flags >= 0 else 0), be32(fam),
                be32(st), be32(pr), be32(len(raw)), raw]
        name = canon.encode() + b"\0" if canon else b""
        out += [be32(len(name)), name]
    out.append(be32(0))
    conn.sendall(b"".join(out))


def gethostbyname(conn, a):
    # gethostbyname <netid> <name> <af>
    name, af = a[1], int(a[2])
    try:
        addrs = sorted({r[4][0] for r in socket.getaddrinfo(
            name, None, af, socket.SOCK_STREAM)})
    except socket.gaierror:
        conn.sendall(ERR + be32(1))  # HOST_NOT_FOUND
        return
    size = 4 if af == socket.AF_INET else 16
    nm = name.encode() + b"\0"
    out = [OK, be32(len(nm)), nm, be32(0),          # name, no aliases
           be32(af), be32(size)]
    for ad in addrs:
        out += [be32(size), socket.inet_pton(af, ad)]
    out.append(be32(0))
    conn.sendall(b"".join(out))


def serve(conn):
    try:
        buf = b""
        while b"\0" not in buf:
            d = conn.recv(4096)
            if not d:
                return
            buf += d
        words = buf.split(b"\0", 1)[0].decode(errors="replace").split()
        if os.environ.get("DNSPROXYD_DEBUG"):
            print("request:", words, flush=True)
        if words and words[0].isdigit():   # optional FrameworkListener seq
            words = words[1:]
        if words[:1] == ["getaddrinfo"] and len(words) >= 7:
            getaddrinfo(conn, words[1:])
        elif words[:1] == ["gethostbyname"] and len(words) >= 4:
            gethostbyname(conn, words[1:])
        else:
            conn.sendall(ERR + be32(-95))  # EOPNOTSUPP
    except OSError:
        pass
    finally:
        conn.close()


def main():
    try:
        os.unlink(PATH)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(PATH)
    os.chmod(PATH, 0o666)
    s.listen(16)
    while True:
        c, _ = s.accept()
        threading.Thread(target=serve, args=(c,), daemon=True).start()


if __name__ == "__main__":
    main()
