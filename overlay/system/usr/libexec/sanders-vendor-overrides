#!/bin/sh
# Fix vendor binaries that can't work under Halium. /vendor is read-only, so
# patch a copy in /run and bind-mount it over the original in the container's
# rootfs (already rbind-mounted from /android by mount-android-partitions).
R=/var/lib/lxc/android/rootfs
# /run is noexec; patched binaries need their own tmpfs
B=/run/sanders-vendor
mkdir -p $B
mountpoint -q $B || mount -t tmpfs -o mode=0755,size=4m sanders-vendor $B

# vndservicemanager aborts on CHECK(selinux_status_open(true) >= 0): the
# kernel runs AppArmor, so there is no selinuxfs. The GSI's servicemanager
# can't stand in: it is built against system libbinder and rejects the
# vendor ('VNDR') parcels of the QTI display stack (display.qservice).
# NOP the branch to the CHECK failure (tbnz w0, #31 at 0x50a0) in the
# PE11 sanders binary; leave anything else alone.
VSM=$R/vendor/bin/vndservicemanager
if [ "$(sha256sum "$VSM" | cut -c1-64)" = "1e8e946fb8607f0fd560a2fd9c514e15f74e3dec66e8871b9c79d2aa519c36e3" ]; then
    cp "$VSM" $B/vndservicemanager
    printf '\037\040\003\325' | dd of=$B/vndservicemanager bs=1 seek=20640 conv=notrunc 2>/dev/null
    if [ "$(sha256sum $B/vndservicemanager | cut -c1-64)" = "e3e76be1b41125de1b2536b8cb11ec9b3848247b0bba1c6b69904c27882e26a7" ]; then
        chmod 755 $B/vndservicemanager
        chown 0:2000 $B/vndservicemanager
        mount --bind $B/vndservicemanager "$VSM"
    fi
fi

# pulseaudio-modules-droid segfaults in pa_droid_profile_set_default_new on
# the route to "HDMI Out" (sanders has no HDMI). Give it a copy of the audio
# policy without that port and route; halium.yaml points
# PulseaudioModulesDroid_ExtraCardArgs at it.
A=$B/audio
mkdir -p $A
cp $R/vendor/etc/*audio_policy*.xml $R/vendor/etc/default_volume_tables.xml $A/ 2>/dev/null
python3 - "$A/audio_policy_configuration.xml" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p).read()
s = re.sub(r'\s*<devicePort tagName="HDMI Out".*?</devicePort>', '', s, flags=re.S)
s = re.sub(r'\s*<route type="mix" sink="HDMI Out"[^>]*/>', '', s, flags=re.S)
open(p, 'w').write(s)
PY
chmod -R a+rX $A

# usb-moded owns the android_usb gadget (MTP, tethering, developer mode).
# The Moto vendor rc rewrites it on every sys.usb.config change, and Android
# boots with sys.usb.config=mtp; rename those triggers so they never fire.
U=$R/vendor/etc/init/hw/init.mmi.usb.rc
if [ -f "$U" ]; then
    sed 's/^on property:sys\.usb\.config=/on property:sys.usb.config.ut-disabled=/' "$U" > $B/init.mmi.usb.rc
    chmod 644 $B/init.mmi.usb.rc
    mount --bind $B/init.mmi.usb.rc "$U"
fi
