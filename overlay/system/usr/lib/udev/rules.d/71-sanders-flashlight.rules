# The flashlight toggle (ayatana-indicator-power) runs as the user and writes
# these directly; sanders has a dual-tone rear flash (torch 0/1 + switch).
SUBSYSTEM=="leds", KERNEL=="torch-light*|led:torch_*|led:switch*|led:flash_torch|flashlight", ACTION=="add", RUN+="/bin/chmod 0666 /sys%p/brightness"
