From 77b4db9441303e225564fb09cda51683c6e7ad7f Mon Sep 17 00:00:00 2001
From: EEMuk <EEMuk@users.noreply.github.com>
Date: Fri, 23 Oct 2026 08:55:42 +0530
Subject: [PATCH 1/2] gprs: ignore data registration drops shorter than 5 s

msm8953 modems briefly report data as not registered around IMS/LTE
procedures; tearing the data call down for those cut connections.
---
 src/binder_gprs.c | 68 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/src/binder_gprs.c b/src/binder_gprs.c
index c007246..ab0bcda 100644
--- a/src/binder_gprs.c
+++ b/src/binder_gprs.c
@@ -43,6 +43,7 @@ typedef struct binder_gprs {
     gulong network_event_id[NETWORK_EVENT_COUNT];
     gulong data_event_id;
     guint set_attached_id;
+    guint reg_debounce_id;
     guint init_id;
     char* log_prefix;
 } BinderGprs;
@@ -99,6 +100,31 @@ binder_gprs_fix_registration_status(
     }
 }
 
+#define BINDER_GPRS_REG_DEBOUNCE_MS (5000)
+
+static gboolean binder_gprs_reg_debounce_cb(gpointer user_data);
+
+static
+gboolean
+binder_gprs_status_registered(
+    enum ofono_netreg_status status)
+{
+    return status == OFONO_NETREG_STATUS_REGISTERED ||
+        status == OFONO_NETREG_STATUS_ROAMING;
+}
+
+static
+void
+binder_gprs_cancel_reg_debounce(
+    BinderGprs* self)
+{
+    if (self->reg_debounce_id) {
+        DBG_(self, "data reg debounce cancelled");
+        g_source_remove(self->reg_debounce_id);
+        self->reg_debounce_id = 0;
+    }
+}
+
 static
 void
 binder_gprs_data_update_registration_state(
@@ -107,6 +133,43 @@ binder_gprs_data_update_registration_state(
     const enum ofono_netreg_status status = binder_gprs_fix_registration_status
         (self, self->network->data.status);
 
+    if (self->reg_status != status) {
+        if (binder_gprs_status_registered(self->reg_status) &&
+            !binder_gprs_status_registered(status) &&
+            binder_data_allowed(self->data)) {
+            /*
+             * Some modems (msm8953) briefly report data as not registered
+             * during IMS/LTE procedures. Don't tear down data calls for
+             * such blips, wait and see if registration comes back.
+             */
+            if (!self->reg_debounce_id) {
+                DBG_(self, "data reg lost, waiting %d ms",
+                    BINDER_GPRS_REG_DEBOUNCE_MS);
+                self->reg_debounce_id = g_timeout_add(
+                    BINDER_GPRS_REG_DEBOUNCE_MS,
+                    binder_gprs_reg_debounce_cb, self);
+            }
+            return;
+        }
+        ofono_info("data reg changed %d -> %d (%s), attached %d",
+            self->reg_status, status, ofono_netreg_status_to_string(status),
+            self->attached);
+        self->reg_status = status;
+        ofono_gprs_status_notify(self->gprs, self->reg_status);
+    }
+    binder_gprs_cancel_reg_debounce(self);
+}
+
+static
+gboolean
+binder_gprs_reg_debounce_cb(
+    gpointer user_data)
+{
+    BinderGprs* self = user_data;
+    const enum ofono_netreg_status status = binder_gprs_fix_registration_status
+        (self, self->network->data.status);
+
+    self->reg_debounce_id = 0;
     if (self->reg_status != status) {
         ofono_info("data reg changed %d -> %d (%s), attached %d",
             self->reg_status, status, ofono_netreg_status_to_string(status),
@@ -114,6 +177,7 @@ binder_gprs_data_update_registration_state(
         self->reg_status = status;
         ofono_gprs_status_notify(self->gprs, self->reg_status);
     }
+    return G_SOURCE_REMOVE;
 }
 
 static
@@ -304,6 +368,10 @@ binder_gprs_remove(
         g_source_remove(self->init_id);
     }
 
+    if (self->reg_debounce_id) {
+        g_source_remove(self->reg_debounce_id);
+    }
+
     binder_network_remove_all_handlers(self->network, self->network_event_id);
     binder_network_unref(self->network);
 
-- 
